# Difaac Configuration Environment Variables
#
# Copy to .env and fill in. Never commit the real .env.

# Server Mode (true for local development, false for production)
DIFAAC_DEBUG=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Full connection string. Leaving it unset falls back to the local
# docker-compose Postgres service, so `docker compose up` needs no extra
# configuration. Set it explicitly for any database outside that stack — a
# managed Postgres, or a server on another host.
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED when DIFAAC_DEBUG=false — the app refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In DEBUG a random key is generated per run, so sessions end on restart.
# Changing this value invalidates every issued token.
DIFAAC_SECRET_KEY=

# Access tokens cannot be revoked before they expire, so they are kept short
# and continuity comes from the refresh cookie instead. This file previously
# suggested 480 — eight hours — which quietly undid that: a stolen token stayed
# usable for a working day.
DIFAAC_ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a password reset link stays valid.
DIFAAC_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Where the frontend is served — used to build the password reset link. A
# wrong value here does not fail loudly: the reset email is sent and the link
# in it points at the wrong host. In production this is https://difaac.com.
DIFAAC_FRONTEND_URL=https://localhost:5173

# ---------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ---------------------------------------------------------------------------
# Must list the exact scheme, host, and port the frontend is served from.
# Note: Vite picks the next free port if 5173 is taken (5174, 5175, ...), so a
# second dev server will be blocked unless its port is listed here too.
#
# In production this is the one origin the site is served from and nothing
# else — behind Caddy the browser calls /api on the same origin, so the list
# is https://difaac.com,https://www.difaac.com. Leaving the localhost entries
# in a production file means a page served from a developer's machine can call
# the live API with a live session.
DIFAAC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173,https://localhost:5174,https://localhost:5175,https://localhost:5176

# ---------------------------------------------------------------------------
# Rate Limiting (per client IP, per minute)
# ---------------------------------------------------------------------------
# General budget for content endpoints.
DIFAAC_RATE_LIMIT_RPM=120

# Tighter budget for the endpoints that verify a credential. Keep this low: it
# is what makes password guessing impractical.
DIFAAC_RATE_LIMIT_AUTH_RPM=10

# ---------------------------------------------------------------------------
# Trusted reverse proxies
# ---------------------------------------------------------------------------
# REQUIRED whenever this service sits behind a proxy — which in this stack it
# always does, since Caddy terminates TLS in front of it.
#
# Every connection then arrives from the proxy, so without this the limits
# above are applied to one client: ten login attempts per minute for the whole
# internet, and a shared general budget that a handful of simultaneous visitors
# exhausts. Sessions and detections are recorded against the proxy's address
# too, which leaves the audit trail unable to say where anything came from.
#
# Set it to the address or CIDR block the proxy connects from — never to
# 0.0.0.0/0, which would let any caller name its own address in the header and
# escape the limit entirely. docker-compose.yml sets this to 172.16.0.0/12,
# the range Docker allocates its internal networks from.
#
# Left empty the forwarded header is ignored, which is correct only when the
# API is exposed directly.
DIFAAC_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Sample data
# Loads the demonstration threat data on first start. Defaults to on in DEBUG
# and off otherwise, so a production server begins empty apart from the admin
# account. Do not set this to true on a live server: the sample incidents and
# phishing domains would sit alongside real ones with nothing marking them
# apart.
DIFAAC_SEED_DEMO=

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------
# REQUIRED for password reset to work at all. With DIFAAC_DEBUG=false and no
# host set, /auth/forgot-password answers 503 rather than telling the user a
# link is on its way that nothing will ever send.
#
# In DEBUG the link is written to the log instead, which is what local
# development wants and cannot happen on a live server.
#
# Any SMTP relay works: one on the VPS, Gmail, SES, Postmark, Resend.
# Port 587 with STARTTLS is the usual choice; port 465 is implicit TLS and
# ignores the STARTTLS flag.
DIFAAC_SMTP_HOST=
DIFAAC_SMTP_PORT=587
DIFAAC_SMTP_STARTTLS=true
DIFAAC_SMTP_USERNAME=
DIFAAC_SMTP_PASSWORD=

# The address mail is sent as. Must be one the relay will accept, or the
# message is refused or filed as spam.
DIFAAC_SMTP_FROM=no-reply@difaac.com

# ---------------------------------------------------------------------------
# Demo showcase logins
# ---------------------------------------------------------------------------
# Leave OFF (blank/false) for any real instance. When true, a fixed set of
# public, known-password accounts is created on every start — admin, analyst
# and viewer in the Difaac tenant, plus a hospital admin with a few sample
# record-access events — so a throwaway demo has working logins without shell
# access. These are PUBLIC credentials; never enable this where real data
# lives, and change the passwords if you keep any of the accounts.
DIFAAC_SEED_DEMO_ACCOUNTS=false

# Error Tracking (optional)
# ---------------------------------------------------------------------------
# Leave unset to disable. When set, unhandled exceptions are reported to
# Sentry. Get a DSN by creating a project at https://sentry.io.
DIFAAC_SENTRY_DSN=
