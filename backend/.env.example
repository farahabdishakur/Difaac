# Difaac Configuration Environment Variables
#
# Copy to .env and fill in. Never commit the real .env.

# Server Mode (true for local development, false for production)
DIFAAC_DEBUG=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Full connection string. Leaving it unset falls back to the local
# docker-compose Postgres service, so `docker compose up` needs no extra
# configuration. Set it explicitly for any database outside that stack — a
# managed Postgres, or a server on another host.
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED when DIFAAC_DEBUG=false — the app refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In DEBUG a random key is generated per run, so sessions end on restart.
# Changing this value invalidates every issued token.
DIFAAC_SECRET_KEY=

DIFAAC_ACCESS_TOKEN_EXPIRE_MINUTES=480

# How long a password reset link stays valid.
DIFAAC_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Where the frontend is served — used to build the password reset link. A
# wrong value here does not fail loudly: the reset email is sent and the link
# in it points at the wrong host. In production this is https://difaac.com.
DIFAAC_FRONTEND_URL=https://localhost:5173

# ---------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ---------------------------------------------------------------------------
# Must list the exact scheme, host, and port the frontend is served from.
# Note: Vite picks the next free port if 5173 is taken (5174, 5175, ...), so a
# second dev server will be blocked unless its port is listed here too.
#
# In production this is the one origin the site is served from and nothing
# else — behind Caddy the browser calls /api on the same origin, so the list
# is https://difaac.com,https://www.difaac.com. Leaving the localhost entries
# in a production file means a page served from a developer's machine can call
# the live API with a live session.
DIFAAC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173,https://localhost:5174,https://localhost:5175,https://localhost:5176

# ---------------------------------------------------------------------------
# Rate Limiting (per client IP, per minute)
# ---------------------------------------------------------------------------
# General budget for content endpoints.
DIFAAC_RATE_LIMIT_RPM=120

# Tighter budget for /auth/login and /auth/register. Keep this low: it is what
# makes password guessing impractical.
DIFAAC_RATE_LIMIT_AUTH_RPM=10

# ---------------------------------------------------------------------------
# Sample data
# Loads the demonstration threat data on first start. Defaults to on in DEBUG
# and off otherwise, so a production server begins empty apart from the admin
# account. Do not set this to true on a live server: the sample incidents and
# phishing domains would sit alongside real ones with nothing marking them
# apart.
DIFAAC_SEED_DEMO=

# Error Tracking (optional)
# ---------------------------------------------------------------------------
# Leave unset to disable. When set, unhandled exceptions are reported to
# Sentry. Get a DSN by creating a project at https://sentry.io.
DIFAAC_SENTRY_DSN=
